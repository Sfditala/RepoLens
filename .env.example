# Which model provider to use: auto | gemini | anthropic
# auto = Gemini if GOOGLE_API_KEY is set, otherwise Claude if ANTHROPIC_API_KEY is set
REPOLENS_PROVIDER=auto

# Google AI Studio key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Anthropic key (optional, only if you want to use Claude)
ANTHROPIC_API_KEY=

REPOLENS_GEMINI_MODEL=gemini-3.5-flash
# Used when the main Gemini model is overloaded (503) or out of quota; empty = no fallback
REPOLENS_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
REPOLENS_ANTHROPIC_MODEL=claude-opus-5-5
# How much the model reasons before answering: low | medium | high | xhigh | max
REPOLENS_EFFORT=medium
# Claude only: re-run a refused request on a fallback model
REPOLENS_REFUSAL_FALLBACK=true

# Max model requests per minute (0 = unlimited). Gemini free tier allows 5.
REPOLENS_REQUESTS_PER_MINUTE=5

# Language of the final report: ar | en
REPOLENS_REPORT_LANG=ar
REPOLENS_MAX_COMMITS=20
REPOLENS_MAX_CODE_FILES=5
REPOLENS_MAX_LINES_PER_FILE=150
